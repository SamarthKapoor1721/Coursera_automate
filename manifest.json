{
  "manifest_version": 3,
  "name": "Coursera Speed Boost",
  "version": "1.0.0",
  "description": "Play Coursera lecture videos up to 16x speed, with auto-mute above 4x since speech becomes unintelligible past that point.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.coursera.org/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.coursera.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coursera Speed Boost"
  },
  "commands": {
    "cycle-speed": {
      "suggested_key": { "default": "Alt+S", "mac": "Command+Shift+S" },
      "description": "Cycle playback speed preset"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
