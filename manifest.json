{
  "manifest_version": 3,
  "name": "Coursera Skippy",
  "version": "1.1.0",
  "description": "Play Coursera lecture videos up to 16x speed, seek, auto-advance videos and reading pages, and skip items.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.coursera.org/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.coursera.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coursera Skippy"
  },
  "commands": {
    "cycle-speed": {
      "suggested_key": { "default": "Alt+S", "mac": "Command+Shift+S" },
      "description": "Cycle playback speed preset"
    },
    "next-item": {
      "suggested_key": { "default": "Alt+N", "mac": "Command+Shift+N" },
      "description": "Mark complete & Go to next item"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
